# Attach the existing Caddy container and cloudflared to little-garden-ingress.
# The tunnel service URL is http://caddy:18180 (use your Caddy container name).
# Do NOT publish port 18180 on the host or add a public alternative garden proxy.
http://:18180 {
    encode zstd gzip
    request_body {
        max_size 8KB
    }
    reverse_proxy garden:8080 {
        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
    }
}
