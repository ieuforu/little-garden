# Copy to deploy/.env on the server. Never commit the real file.
PUBLIC_ORIGIN=https://garden.example.com
# Generate locally: openssl rand -hex 32
SESSION_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# This is the dedicated Docker network's CIDR, NOT all Docker/private IPs.
# Caddy must overwrite X-Real-IP as shown in the supplied snippets.
TRUSTED_PROXIES=172.30.21.0/28
MAX_WEBSOCKETS=200
GARDEN_PORT=18080
GARDEN_SUBNET=172.30.21.0/28
